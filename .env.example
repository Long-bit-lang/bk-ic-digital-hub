# ==============================================================================
# BK-IC DIGITAL HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME ENVIRONMENT (Private - Backend Only)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# APP_URL: The public HTTPS URL where this app is hosted on the Internet.
# Used for QR code generation, email verification links, and CORS whitelist.
APP_URL="https://your-domain.run.app"

# CORS_ORIGIN: Optional comma-separated list of additional allowed origins for CORS.
CORS_ORIGIN="https://your-domain.run.app,https://bk-ic.dut.udn.vn"

# ------------------------------------------------------------------------------
# 2. AI STUDIO & GEMINI API (Backend Only)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Automatically injected by AI Studio at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL DELIVERY CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
# Used for real outbox delivery (DUT mail server, Brevo, SendGrid, Gmail SMTP).
# If credentials are not set, emails are safely stored in the secure Admin Outbox.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="example@dut.udn.vn"
SMTP_PASS="your_secure_smtp_app_password"
SMTP_FROM="BK-IC Digital Hub <no-reply@dut.udn.vn>"

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT CONFIGURATION (Public - Prefix VITE_)
# ------------------------------------------------------------------------------
# Public app URL for client-side routing & QR generator fallback
VITE_APP_URL="https://ais-pre-kvwnyqgldgvbbnmnqqf7j6-427666384680.asia-southeast1.run.app"

# Optional Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

